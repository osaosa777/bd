-- SQLBook: Code
create table Books (
    ISBN VARCHAR(100) PRIMARY KEY,
    Title VARCHAR(1000) NOT NULL,
    Year_of_publication INT CHECK(Year_of_publication > 0)
);

create table Authors (
    Author_id INT PRIMARY KEY,
    Author_full_name VARCHAR(1000) NOT NULL
);


